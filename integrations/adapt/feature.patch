+    <p v-if="!assignmentId || !questionId">Discussion responses are available after this question is added to an assignment.</p>
+    <template v-else>
+      <p><a :href="`/discuss-it/${assignmentId}/${questionId}`" target="_blank" rel="noopener">Open full-screen discussion (recommended on mobile)</a></p>
+      <p v-if="error" role="alert" class="alert alert-danger">{{ error }}</p>
+      <p role="status">{{ status }}</p>
+      <details v-if="owner && settings" class="mb-3">
+        <summary>Instructor discussion settings</summary>
+        <fieldset :disabled="sending">
+          <label v-for="(label, key) in booleanSettings" :key="key"><input v-model="settings[key]" type="checkbox"> {{ label }}</label>
+          <label v-for="(label, key) in numberSettings" :key="key">{{ label }}<input v-model.number="settings[key]" type="number" min="0" :max="key === 'min_seconds' ? 300 : key === 'min_words' ? 1000 : 20"></label>
+          <p class="small">Completion and section rules lock after the first response. Moderating a graded post does not automatically retract its grade.</p>
+          <button class="btn btn-primary" type="button" @click="saveSettings">Save settings</button>
+        </fieldset>
+      </details>
+      <p v-if="settings && !settings.enabled">The instructor has not enabled this discussion.</p>
+      <template v-if="settings && settings.enabled">
+        <p v-if="!owner">{{ completion.threads }} / {{ settings.min_threads }} threads; {{ completion.replies }} / {{ settings.min_replies }} replies. {{ completion.complete ? 'Participation requirements met.' : '' }}</p>
+        <p>Each response: at least {{ settings.min_words }} word(s), or {{ settings.min_seconds }} seconds of audio/video. Maximum recording: 5 minutes / 80 MB.</p>
+        <button v-if="!composing" type="button" class="btn btn-primary" @click="compose(null)">Start a thread</button>
+        <section v-if="composing" ref="composer" tabindex="-1" class="composer">
+          <h3 class="h5">{{ parentId ? 'Reply to thread' : 'New thread' }}</h3>
+          <fieldset :disabled="sending || recordingBusy">
+            <label>Response type<select v-model="kind" @change="resetAttachment"><option value="text">Text</option><option value="video">Video</option><option value="audio">Audio</option></select></label>
+            <label v-if="owner && settings.group_by_section && !parentId">Section ID<input v-model="sectionId" type="number" min="1"></label>
+          </fieldset>
+          <fieldset :disabled="sending" aria-label="Recorder">
+            <VideoRecorder v-if="kind !== 'text'" :key="`${kind}-${recorderKey}`" :audio-only="kind === 'audio'" @recorded="recorded" @busy="recordingBusy = $event" />
+          </fieldset>
+          <label v-if="kind !== 'text'">Or upload an existing {{ kind }} (background effects apply only to recordings made above)
+            <input type="file" :accept="kind === 'video' ? 'video/mp4,video/webm,video/quicktime' : 'audio/*'" :disabled="sending || recordingBusy" @change="uploadFile">
+          </label>
+          <p v-if="attachmentName">Attached: {{ attachmentName }}</p>
+          <label>{{ kind === 'text' ? 'Your response' : 'Text alternative / description' }}<textarea v-model="text" maxlength="10000" rows="4" :disabled="sending" /></label>
+          <label v-if="kind !== 'text'">Optional captions (WebVTT)<textarea v-model="captions" maxlength="20000" rows="3" :disabled="sending" placeholder="WEBVTT" /></label>
+          <p v-if="kind !== 'text'" class="small">Automatic transcription is not enabled. Add a text alternative or your own captions.</p>
+          <button type="button" class="btn btn-primary" :disabled="sending || recordingBusy || (kind !== 'text' && !attachment)" @click="submit">{{ sending ? 'Submitting… keep this page open' : 'Submit response' }}</button>
+          <button type="button" class="btn btn-outline-secondary" :disabled="sending" @click="closeComposer">Cancel response</button>
+        </section>
+      </template>
+      <article v-for="thread in threads" :key="thread.id" class="thread">
+        <DiscussItComment :comment="thread" :base="base" @changed="load" @error="error = $event" />
+        <div v-for="reply in replies(thread.id)" :key="reply.id" class="reply"><DiscussItComment :comment="reply" :base="base" @changed="load" @error="error = $event" /></div>
+        <button v-if="settings.enabled && !thread.deleted_at && !composing" type="button" class="btn btn-outline-primary" @click="compose(thread.id)">Reply to {{ thread.author }}</button>
+      </article>
+      <p v-if="settings && settings.enabled && !threads.length">No responses yet. Start the conversation.</p>
+    </template>
+  </section>
+</template>
+
+<script>
+import axios from 'axios'
+import DOMPurify from 'dompurify'
+import { v4 as uuid } from 'uuid'
+import VideoRecorder from '../recording/VideoRecorder'
+import DiscussItComment from './DiscussItComment'
+export default {
+  components: { VideoRecorder, DiscussItComment },
+  props: { assignmentId: { type: [Number, String], default: 0 }, questionId: { type: [Number, String], default: 0 }, qtiJson: { type: Object, default: null } },
+  data: () => ({ owner: false,
+    settings: null,
+    comments: [],
+    completion: {},
+    prompt: '',
+    error: '',
+    status: '',
+    composing: false,
+    parentId: null,
+    kind: 'video',
+    text: '',
+    captions: '',
+    sectionId: '',
+    attachment: null,
+    attachmentName: '',
+    mediaId: null,
+    requestId: '',
+    sending: false,
+    recordingBusy: false,
+    recorderKey: 0,
+    uploadTicket: null,
+    booleanSettings: { enabled: 'Enable discussion', auto_grade: 'Award completion credit automatically', allow_edit: 'Allow editing ungraded responses', allow_delete: 'Allow deleting ungraded responses', group_by_section: 'Separate discussions by course section' },
+    numberSettings: { min_threads: 'Required new threads', min_replies: 'Required replies', min_words: 'Minimum words for text', min_seconds: 'Minimum seconds for media' } }),
+  computed: {
+    base () { return `/api/discuss-it/${this.assignmentId}/${this.questionId}` },
+    threads () { return this.comments.filter(comment => !comment.parent_id) },
+    // Question authors write the prompt as HTML; never run their scripts in a viewer's session.
+    // Keep the embedded videos and new-window links the prompt editor can produce.
+    safePrompt () { return DOMPurify.sanitize(this.prompt || (this.qtiJson && this.qtiJson.prompt) || '', { ADD_TAGS: ['iframe'], ADD_ATTR: ['allowfullscreen', 'frameborder', 'target'] }) }
+  },
+  mounted () { this.load(); this.unload = event => { if (this.composing) { event.preventDefault(); event.returnValue = '' } }; window.addEventListener('beforeunload', this.unload) },
+  beforeDestroy () { this.disposed = true; window.removeEventListener('beforeunload', this.unload) },
+  methods: {
+    message (error) { return (error.response && error.response.data && error.response.data.message) || error.message || 'Request failed. Please retry.' },
+    async load () {
+      if (!this.assignmentId || !this.questionId) return
+      try { const { data } = await axios.get(this.base); this.owner = data.owner; this.settings = data.settings; this.comments = data.comments; this.completion = data.completion; this.prompt = data.prompt } catch (error) { this.error = this.message(error) }
+    },
+    async saveSettings () { try { await axios.put(`${this.base}/settings`, this.settings); this.error = ''; this.status = 'Settings saved.'; await this.load() } catch (error) { this.error = this.message(error) } },
+    replies (id) { return this.comments.filter(comment => comment.parent_id === id) },
+    compose (parentId) { this.parentId = parentId; this.composing = true; this.requestId = uuid(); this.status = ''; this.error = ''; this.$nextTick(() => this.$refs.composer.focus()) },
+    closeComposer () { if ((!this.attachment && !this.text && !this.recordingBusy) || window.confirm('Discard your unsent response?')) { this.composing = false; this.text = ''; this.captions = ''; this.resetAttachment() } },
+    resetAttachment () { this.attachment = null; this.attachmentName = ''; this.mediaId = null; this.uploadTicket = null; this.recorderKey++ },
+    recorded (result) { this.attachment = result ? result.blob : null; this.attachmentName = result ? `recording.${result.extension}` : ''; this.mediaId = null; this.uploadTicket = null },
+    uploadFile (event) {
+      const file = event.target.files[0]
+      if (!file) return
+      if (file.size > 80000000) { this.error = 'Choose a recording under 80 MB.'; return }
+      this.recorderKey++; this.$nextTick(() => { this.attachment = file; this.attachmentName = file.name; this.mediaId = null; this.uploadTicket = null })
+    },
+    async submit () {
+      this.error = ''; this.sending = true
+      try {
+        if (this.kind !== 'text') {
+          await this.upload()
+          this.status = 'Processing recording for mobile playback… This may take a few minutes.'
+          let ready = false
+          for (let attempt = 0; attempt < 120; attempt++) {
+            if (this.disposed) return
+            const { data } = await axios.get(`${this.base}/media/${this.mediaId}`)
+            if (data.status === 'ready') { ready = true; break }
+            if (data.status === 'failed') { this.mediaId = null; this.uploadTicket = null; throw new Error(data.error) }
+            await new Promise(resolve => setTimeout(resolve, 3000))
+          }
+          if (!ready) throw new Error('Processing is still running. Your clip is retained; retry Submit shortly.')
+        }
+        await axios.post(`${this.base}/comments`, { request_id: this.requestId, parent_id: this.parentId, text: this.text, captions: this.captions, media_id: this.mediaId, group_key: `section:${this.sectionId}` })
+        this.composing = false; this.text = ''; this.captions = ''; this.resetAttachment(); this.status = 'Response submitted.'; await this.load()
+      } catch (error) { this.error = this.message(error); this.status = 'Not submitted. Your response remains available to retry.' } finally { this.sending = false }
+    },
+    async upload () {
+      // Leaving the question mid-upload clears the attachment and ticket, but an upload that
+      // completes must still be finalized, or it counts against the pending-upload limit.
+      const attachment = this.attachment
+      for (let attempt = 0; ; attempt++) {
+        try {
+          let mediaId = this.mediaId
+          if (!mediaId) {
+            let ticket = this.uploadTicket
+            if (!ticket) {
+              this.status = 'Requesting upload…'
+              ticket = (await axios.post(`${this.base}/uploads`, { kind: this.kind, size: attachment.size })).data
+              this.uploadTicket = ticket
+            }
+            await this.send(ticket.url, attachment)
+            mediaId = this.mediaId = ticket.id
+          }
+          await axios.post(`${this.base}/media/${mediaId}/finalize`)
+          return
+        } catch (error) {
+          // An expired (410) or removed (404) upload cannot be reused. Start over once, unless
+          // the student has left the question.
+          if (attempt || this.disposed || !error.response || ![404, 410].includes(error.response.status)) throw error
+          this.mediaId = null; this.uploadTicket = null
+        }
+      }
+    },
+    async send (url, attachment) {
+      // Cancel only when the upload stops making progress, so slow connections can finish.
+      // A cancel token rather than an AbortSignal: axios before 0.22 ignores `signal`.
+      const cancel = axios.CancelToken.source()
+      let stalled = false
+      let timer
+      const wait = milliseconds => { clearTimeout(timer); timer = setTimeout(() => { stalled = true; cancel.cancel() }, milliseconds) }
+      let shown = -1
+      this.status = 'Uploading recording…'
+      wait(60000)
+      try {
+        await axios.put(url, attachment, {
+          headers: { 'Content-Type': attachment.type || 'application/octet-stream' },
+          cancelToken: cancel.token,
+          onUploadProgress: ({ loaded, total }) => {
+            // After the last byte, give the server time to store the file.
+            wait(total && loaded >= total ? 180000 : 60000)
+            const percent = total ? Math.floor(loaded / total * 10) * 10 : -1
+            if (percent > shown) { shown = percent; this.status = `Uploading recording… ${percent}%` }
+          }
+        })
+      } catch (error) {
+        if (stalled) throw new Error('The upload stopped making progress. Check your connection, then submit again.')
+        throw error
+      } finally { clearTimeout(timer) }
+    }
+  }
+}
+</script>
+
