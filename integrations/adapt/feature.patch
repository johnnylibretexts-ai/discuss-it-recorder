@@ -0,0 +1,43 @@
+<template>
+  <div>
+    <p><strong>{{ comment.author }}</strong> <small>{{ comment.created_at }} UTC</small></p>
+    <p v-if="comment.text" class="response-text">{{ comment.text }}</p>
+    <button v-if="comment.media_id && !media" class="btn btn-outline-primary" type="button" @click="play">Load recording</button>
+    <video v-if="media && media.kind === 'video'" :src="media.url" controls playsinline crossorigin="anonymous" preload="metadata" @error="media = null">
+      <track v-if="captionUrl" kind="captions" :src="captionUrl" srclang="en" label="Captions" default>
+    </video>
+    <audio v-if="media && media.kind === 'audio'" :src="media.url" controls preload="metadata" @error="media = null" />
+    <details v-if="comment.captions"><summary>Transcript / captions</summary><pre>{{ comment.captions }}</pre></details>
+    <p v-if="!comment.deleted_at && !comment.satisfied" class="small">This response does not meet the minimum length for completion credit.</p>
+    <div v-if="editing">
+      <label>Response text<textarea v-model="editText" rows="4" maxlength="10000" /></label>
+      <label v-if="comment.media_id">Captions (WebVTT)<textarea v-model="editCaptions" rows="3" maxlength="20000" /></label>
+      <button class="btn btn-primary" type="button" @click="save">Save changes</button>
+      <button class="btn btn-outline-secondary" type="button" @click="editing = false">Cancel</button>
+    </div>
+    <button v-if="comment.can_edit && !editing" class="btn btn-outline-secondary" type="button" @click="edit">Edit text / captions</button>
+    <button v-if="comment.can_delete" class="btn btn-outline-danger" type="button" @click="remove">Remove response</button>
+  </div>
+</template>
+<script>
+import axios from 'axios'
+export default {
+  props: { comment: { type: Object, required: true }, base: { type: String, required: true } },
+  data: () => ({ media: null, captionUrl: '', editing: false, editText: '', editCaptions: '' }),
+  watch: { 'comment.captions': 'updateCaptions' },
+  mounted () { this.updateCaptions() },
+  beforeDestroy () { if (this.captionUrl) URL.revokeObjectURL(this.captionUrl) },
+  methods: {
+    report (error) { this.$emit('error', (error.response && error.response.data.message) || error.message) },
+    updateCaptions () { if (this.captionUrl) URL.revokeObjectURL(this.captionUrl); this.captionUrl = this.comment.captions && this.comment.captions.trim().startsWith('WEBVTT') ? URL.createObjectURL(new Blob([this.comment.captions], { type: 'text/vtt' })) : '' },
+    async play () { try { const { data } = await axios.get(`${this.base}/media/${this.comment.media_id}`); this.media = data } catch (error) { this.report(error) } },
+    edit () { this.editText = this.comment.text || ''; this.editCaptions = this.comment.captions || ''; this.editing = true },
+    async save () { try { await axios.patch(`${this.base}/comments/${this.comment.id}`, { text: this.editText, captions: this.editCaptions }); this.editing = false; this.$emit('changed') } catch (error) { this.report(error) } },
+    async remove () { if (!window.confirm('Remove this response from the discussion? Replies are retained.')) return; try { await axios.delete(`${this.base}/comments/${this.comment.id}`); this.$emit('changed') } catch (error) { this.report(error) } }
+  }
+}
+</script>
+<style scoped>
+video, audio { width: 100%; max-height: 65vh; } .response-text, pre { white-space: pre-wrap; overflow-wrap: anywhere; }
+.btn { min-height: 44px; margin: 4px; white-space: normal; } label, textarea { display: block; width: 100%; }
+</style>
