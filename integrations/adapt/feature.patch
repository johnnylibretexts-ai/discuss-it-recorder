diff --git a/app/Services/DiscussIt.php b/app/Services/DiscussIt.php
new file mode 100644
index 000000000..a0dcb13e5
--- /dev/null
+++ b/app/Services/DiscussIt.php
@@ -0,0 +1,95 @@
+<?php
+
+namespace App\Services;
+
+use App\Assignment;
+use App\Question;
+use App\Score;
+use App\Submission;
+use App\SubmissionFile;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Gate;
+
+class DiscussIt
+{
+    public static function defaults(): array
+    {
+        return ['enabled' => false, 'min_threads' => 1, 'min_replies' => 0,
+            'min_words' => 1, 'min_seconds' => 0, 'auto_grade' => false,
+            'allow_edit' => true, 'allow_delete' => true, 'group_by_section' => false];
+    }
+
+    public function scope(Assignment $assignment, Question $question, bool $write = false): array
+    {
+        $user = request()->user();
+        abort_unless($user, 401);
+        abort_unless(DB::table('assignment_question')->where('assignment_id', $assignment->id)->where('question_id', $question->id)->exists(), 404);
+        abort_unless($question->technology === 'qti' && (json_decode($question->qti_json, true)['questionType'] ?? '') === 'discuss_it', 404);
+        $owner = (int) $assignment->course->user_id === (int) $user->id;
+        $enrollment = DB::table('enrollments')->where('course_id', $assignment->course_id)->where('user_id', $user->id)->first();
+        // Public question previews must never expose private discussion content.
+        abort_unless($owner || ((int) $user->role === 3 && $enrollment), 403);
+        if (!$owner) {
+            abort_unless($assignment->shown, 403, 'This assignment is not available.');
+            $timing = $assignment->assignToTimingByUser();
+            abort_unless($timing && strtotime($timing->available_from) <= time(), 403, 'This assignment is not available yet.');
+        }
+        $row = DB::table('discuss_it_settings')->where('assignment_id', $assignment->id)->where('question_id', $question->id)->first();
+        $settings = array_merge(self::defaults(), $row ? json_decode($row->settings, true) : []);
+        if ($write) {
+            abort_unless($settings['enabled'], 403, 'This discussion is not enabled.');
+            if (!$owner) Gate::authorize('store', [new Submission(), $assignment, $assignment->id, $question->id]);
+        }
+        $group = $settings['group_by_section'] && !$owner ? 'section:'.($enrollment->section_id ?? 0) : 'all';
+        return compact('owner', 'settings', 'group');
+    }
+
+    public function comments(Assignment $assignment, Question $question, array $scope)
+    {
+        $query = DB::table('discuss_it_comments')->where('assignment_id', $assignment->id)->where('question_id', $question->id);
+        if (!$scope['owner']) $query->where('group_key', $scope['group']);
+        return $query;
+    }
+
+    public function satisfied(?string $text, $media, array $settings): bool
+    {
+        if ($media) return $media->duration_ms >= 1000 * $settings['min_seconds'];
+        return count(preg_split('/\s+/u', trim($text ?? ''), -1, PREG_SPLIT_NO_EMPTY)) >= $settings['min_words'];
+    }
+
+    // Once a student's submission for the question is graded, their responses are locked.
+    public function graded(Assignment $assignment, Question $question, int $userId): bool
+    {
+        return DB::table('submission_files')->where('assignment_id', $assignment->id)->where('question_id', $question->id)
+            ->where('user_id', $userId)->whereNotNull('date_graded')->exists();
+    }
+
+    public function completion(Assignment $assignment, Question $question, int $userId, array $settings): array
+    {
+        $query = DB::table('discuss_it_comments')->where('assignment_id', $assignment->id)->where('question_id', $question->id)
+            ->where('user_id', $userId)->whereNull('deleted_at')->where('satisfied', true);
+        $threads = (clone $query)->whereNull('parent_id')->count();
+        $replies = (clone $query)->whereNotNull('parent_id')->count();
+        return ['threads' => $threads, 'replies' => $replies,
+            'complete' => ($threads + $replies > 0) && $threads >= $settings['min_threads'] && $replies >= $settings['min_replies']];
+    }
+
+    public function grade(Assignment $assignment, Question $question, array $scope): void
+    {
+        if ($scope['owner'] || !$scope['settings']['auto_grade']) return;
+        $userId = request()->user()->id;
+        if (!$this->completion($assignment, $question, $userId, $scope['settings'])['complete']) return;
+        $points = DB::table('assignment_question')->where('assignment_id', $assignment->id)->where('question_id', $question->id)->value('points');
+        $submission = SubmissionFile::firstOrNew(['assignment_id' => $assignment->id, 'question_id' => $question->id, 'user_id' => $userId]);
+        if ($submission->exists) return;
+        // Use this fork's existing question-level submission type; no enum rewrite.
+        $submission->type = 'q';
+        $submission->original_filename = '';
+        $submission->submission = '';
+        $submission->date_submitted = now();
+        $submission->date_graded = now();
+        $submission->score = (new Submission())->applyLatePenalyToScore($assignment, $points);
+        $submission->save();
+        (new Score())->updateAssignmentScore($userId, $assignment->id);
+    }
+}
diff --git a/app/Services/DiscussItMediaProcessor.php b/app/Services/DiscussItMediaProcessor.php
new file mode 100644
index 000000000..a78ae2ba2
--- /dev/null
+++ b/app/Services/DiscussItMediaProcessor.php
@@ -0,0 +1,102 @@
+<?php
+
+namespace App\Services;
+
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Facades\Storage;
+use Symfony\Component\Process\Exception\ProcessFailedException;
+use Symfony\Component\Process\Process;
+
+class DiscussItMediaProcessor
+{
+    // One limit for the input probe and the encoded output. Encoding one second past it
+    // lets the output check catch long input that carries no duration metadata.
+    private const MAX_SECONDS = 301;
+
+    private function run(array $arguments, int $timeout): string
+    {
+        $process = new Process($arguments);
+        $process->setTimeout($timeout);
+        $process->mustRun();
+        return $process->getOutput();
+    }
+
+    // A logger that throws (for example, on a log file another user created) must not
+    // stop the remaining jobs in the batch.
+    private function log(string $level, string $message, array $context): void
+    {
+        try { Log::log($level, $message, $context); } catch (\Throwable $error) {}
+    }
+
+    public function process($media): void
+    {
+        $input = tempnam(sys_get_temp_dir(), 'discuss-input-');
+        $output = tempnam(sys_get_temp_dir(), 'discuss-output-');
+        $disk = Storage::disk('s3');
+        try {
+            $size = $disk->size($media->object_key);
+            if ($size < 1 || $size > 80000000) throw new \UnexpectedValueException('Invalid size');
+            $source = $disk->readStream($media->object_key);
+            $destination = fopen($input, 'wb');
+            try { $copied = stream_copy_to_stream($source, $destination, 80000001); }
+            finally { if (is_resource($source)) fclose($source); fclose($destination); }
+            if ($copied > 80000000 || !$copied) throw new \UnexpectedValueException('Invalid input');
+            $formats = 'mov,matroska,webm,mp3,wav,ogg,aac';
+            try {
+                $probe = json_decode($this->run(['ffprobe', '-v', 'error', '-protocol_whitelist', 'file', '-format_whitelist', $formats, '-show_streams', '-show_format', '-of', 'json', $input], 15), true);
+            } catch (ProcessFailedException $error) {
+                // ffprobe exits 1 for any input it cannot read; other codes (126/127 for a
+                // missing or unusable binary) are the server's.
+                if ($error->getProcess()->getExitCode() !== 1) throw $error;
+                throw new \UnexpectedValueException('Unreadable input', 0, $error);
+            }
+            $audio = false;
+            $video = false;
+            foreach ($probe['streams'] ?? [] as $stream) {
+                if ($stream['codec_type'] === 'audio') $audio = true;
+                if ($stream['codec_type'] === 'video') {
+                    $video = true;
+                    if (($stream['width'] ?? 0) * ($stream['height'] ?? 0) > 9000000) throw new \UnexpectedValueException('Resolution too large');
+                }
+            }
+            if (!$audio || ($media->kind === 'video' && !$video)) throw new \UnexpectedValueException('Missing tracks');
+            if (isset($probe['format']['duration']) && (float) $probe['format']['duration'] > self::MAX_SECONDS) throw new \UnexpectedValueException('Too long');
+            $arguments = ['ffmpeg', '-nostdin', '-y', '-v', 'error', '-threads', '2', '-filter_threads', '1', '-protocol_whitelist', 'file', '-format_whitelist', $formats, '-i', $input, '-t', (string) (self::MAX_SECONDS + 1)];
+            if ($media->kind === 'video') {
+                $arguments = array_merge($arguments, ['-map', '0:v:0', '-map', '0:a:0', '-vf', "scale=trunc(iw/2)*2:trunc(ih/2)*2", '-c:v', 'libx264', '-preset', 'veryfast', '-crf', '25', '-pix_fmt', 'yuv420p', '-threads', '2']);
+            } else $arguments = array_merge($arguments, ['-vn', '-map', '0:a:0']);
+            $arguments = array_merge($arguments, ['-c:a', 'aac', '-b:a', '96k', '-ac', '1', '-map_metadata', '-1', '-movflags', '+faststart', '-f', 'mp4', $output]);
+            $this->run($arguments, 180);
+            $duration = (float) trim($this->run(['ffprobe', '-v', 'error', '-show_entries', 'format=duration', '-of', 'default=noprint_wrappers=1:nokey=1', $output], 15));
+            // The half second allows for AAC encoder padding at the end of the output.
+            if ($duration < 0.1 || $duration > self::MAX_SECONDS + 0.5 || filesize($output) > 80000000) throw new \UnexpectedValueException('Invalid output');
+            $key = dirname($media->object_key).'/recording.'.($media->kind === 'video' ? 'mp4' : 'm4a');
+            $stream = fopen($output, 'rb');
+            try {
+                if (!$disk->put($key, $stream, ['visibility' => 'private', 'ContentType' => $media->kind === 'video' ? 'video/mp4' : 'audio/mp4'])) throw new \RuntimeException('Storage failed');
+            } finally { fclose($stream); }
+            DB::table('discuss_it_media')->where('id', $media->id)->update(['status' => 'ready', 'output_key' => $key, 'duration_ms' => (int) round($duration * 1000), 'error' => null, 'updated_at' => now()]);
+            // The recording is stored and ready, so failing to remove the upload must not fail it.
+            try { $disk->delete($media->object_key); } catch (\Throwable $error) {
+                $this->log('warning', 'Discuss-It upload was not removed after processing', ['media_id' => $media->id, 'exception' => get_class($error)]);
+            }
+        } catch (\Throwable $error) {
+            // Only problems found in the media itself are the student's to fix: these checks and
+            // an input ffprobe cannot read. Anything else, including an encoder failure or timeout
+            // (a missing encoder, a full disk, an overloaded server), may be the server's.
+            $rejected = $error instanceof \UnexpectedValueException;
+            DB::table('discuss_it_media')->where('id', $media->id)->update(['status' => 'failed', 'error' => $rejected
+                ? 'Could not process this recording. Use a clip under 5 minutes / 80 MB with microphone audio, then upload again.'
+                : 'A server problem stopped this recording from being processed. Please submit again later.', 'updated_at' => now()]);
+            // Log what failed and where, never signed URLs, student media, or ffmpeg input diagnostics.
+            $this->log($rejected ? 'notice' : 'error', 'Discuss-It media processing failed', ['media_id' => $media->id,
+                'exception' => get_class($error), 'at' => basename($error->getFile()).':'.$error->getLine(),
+                'reason' => $error instanceof \UnexpectedValueException ? $error->getMessage() : null,
+                'exit_code' => $error instanceof ProcessFailedException ? $error->getProcess()->getExitCode() : null]);
+        } finally {
+            if (is_file($input)) unlink($input);
+            if (is_file($output)) unlink($output);
+        }
+    }
+}
diff --git a/app/Console/Commands/LibreTexts/ProcessDiscussItMedia.php b/app/Console/Commands/LibreTexts/ProcessDiscussItMedia.php
