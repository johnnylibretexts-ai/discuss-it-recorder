diff --git a/app/Http/Controllers/DiscussItController.php b/app/Http/Controllers/DiscussItController.php
new file mode 100644
index 000000000..d533c1c0d
--- /dev/null
+++ b/app/Http/Controllers/DiscussItController.php
@@ -0,0 +1,246 @@
+<?php
+
+namespace App\Http\Controllers;
+
+use App\Assignment;
+use App\Question;
+use App\Services\DiscussIt;
+use Illuminate\Http\Request;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Storage;
+use Illuminate\Support\Str;
+use Illuminate\Support\Facades\URL;
+
+class DiscussItController extends Controller
+{
+    public function index(Assignment $assignment, Question $question, DiscussIt $discuss)
+    {
+        $scope = $discuss->scope($assignment, $question);
+        $comments = [];
+        if ($scope['settings']['enabled'] || $scope['owner']) {
+            $rows = $discuss->comments($assignment, $question, $scope)->orderBy('id')->limit(500)->get();
+            $viewer = (int) request()->user()->id;
+            // Look up authors once per page, not once per comment. Viewers can change only their
+            // own responses, so only their own grade matters.
+            $users = $rows->isEmpty() ? collect() : DB::table('users')->whereIn('id', $rows->pluck('user_id')->unique()->values()->all())->get(['id', 'first_name', 'last_name'])->keyBy('id');
+            $graded = $rows->contains(function ($row) use ($viewer) { return (int) $row->user_id === $viewer; }) && $discuss->graded($assignment, $question, $viewer);
+            $comments = $rows->map(function ($row) use ($scope, $users, $graded, $viewer) {
+                $user = $users->get($row->user_id);
+                $own = (int) $row->user_id === $viewer;
+                $row->author = $user ? trim($user->first_name.' '.$user->last_name) : 'Former participant';
+                $row->can_edit = !$row->deleted_at && $own && !$graded && $scope['settings']['allow_edit'];
+                $row->can_delete = !$row->deleted_at && ($scope['owner'] || ($own && !$graded && $scope['settings']['allow_delete']));
+                if ($row->deleted_at) { $row->text = '[Removed]'; $row->media_id = null; $row->captions = null; }
+                unset($row->request_id);
+                return $row;
+            });
+        }
+        return response()->json(array_merge($scope, ['comments' => $comments,
+            'completion' => $discuss->completion($assignment, $question, request()->user()->id, $scope['settings']),
+            'prompt' => json_decode($question->qti_json, true)['prompt'] ?? '', 'title' => $question->title]));
+    }
+
+    public function settings(Request $request, Assignment $assignment, Question $question, DiscussIt $discuss)
+    {
+        $scope = $discuss->scope($assignment, $question);
+        abort_unless($scope['owner'], 403);
+        $settings = $request->validate(['enabled' => 'required|boolean', 'auto_grade' => 'required|boolean',
+            'min_threads' => 'required|integer|min:0|max:20', 'min_replies' => 'required|integer|min:0|max:20',
+            'min_words' => 'required|integer|min:1|max:1000', 'min_seconds' => 'required|integer|min:0|max:300',
+            'allow_edit' => 'required|boolean', 'allow_delete' => 'required|boolean', 'group_by_section' => 'required|boolean']);
+        // Serialize settings with comment writes. Freeze scoring/group rules once work exists.
+        DB::transaction(function () use ($assignment, $question, $settings, $scope) {
+            DB::table('assignment_question')->where('assignment_id', $assignment->id)->where('question_id', $question->id)->lockForUpdate()->first();
+            if (DB::table('discuss_it_comments')->where('assignment_id', $assignment->id)->where('question_id', $question->id)->exists()) {
+                foreach (['auto_grade', 'min_threads', 'min_replies', 'min_words', 'min_seconds', 'group_by_section'] as $key) {
+                    abort_unless($settings[$key] == $scope['settings'][$key], 422, 'Completion and group rules cannot change after a response has been posted.');
+                }
+            }
+            DB::table('discuss_it_settings')->updateOrInsert(['assignment_id' => $assignment->id, 'question_id' => $question->id], ['settings' => json_encode($settings), 'created_at' => now(), 'updated_at' => now()]);
+        });
+        return $this->index($assignment, $question, $discuss);
+    }
+
+    public function store(Request $request, Assignment $assignment, Question $question, DiscussIt $discuss)
+    {
+        $discuss->scope($assignment, $question, true);
+        $data = $request->validate(['request_id' => 'required|uuid', 'parent_id' => 'nullable|integer',
+            'media_id' => 'nullable|uuid', 'text' => 'nullable|string|max:10000', 'captions' => 'nullable|string|max:20000', 'group_key' => 'nullable|string|max:80']);
+        abort_unless(!empty($data['media_id']) || trim($data['text'] ?? '') !== '', 422, 'Write a response or attach a recording.');
+        $id = DB::transaction(function () use ($data, $assignment, $question, $discuss) {
+            DB::table('assignment_question')->where('assignment_id', $assignment->id)->where('question_id', $question->id)->lockForUpdate()->first();
+            $scope = $discuss->scope($assignment, $question, true);
+            $prior = DB::table('discuss_it_comments')->where('user_id', request()->user()->id)->where('request_id', $data['request_id'])->first();
+            if ($prior) {
+                abort_unless($prior->assignment_id == $assignment->id && $prior->question_id == $question->id, 409);
+                return $prior->id;
+            }
+            $group = $scope['group'];
+            if (!empty($data['parent_id'])) {
+                $parent = $discuss->comments($assignment, $question, $scope)->where('id', $data['parent_id'])->whereNull('parent_id')->whereNull('deleted_at')->first();
+                abort_unless($parent, 422, 'That thread is not available.');
+                $group = $parent->group_key;
+            } elseif ($scope['owner'] && $scope['settings']['group_by_section']) {
+                $sectionId = (int) str_replace('section:', '', $data['group_key'] ?? '');
+                abort_unless(DB::table('sections')->where('course_id', $assignment->course_id)->where('id', $sectionId)->exists(), 422, 'Choose a course section for this thread.');
+                $group = 'section:'.$sectionId;
+            }
+            $media = null;
+            if (!empty($data['media_id'])) {
+                $media = $this->ownedMedia($data['media_id'], $assignment, $question);
+                abort_unless($media->status === 'ready', 422, 'Recording is not ready yet.');
+                abort_if(DB::table('discuss_it_comments')->where('media_id', $media->id)->exists(), 409, 'This recording has already been posted.');
+            }
+            $id = DB::table('discuss_it_comments')->insertGetId([
+                'assignment_id' => $assignment->id, 'question_id' => $question->id, 'user_id' => request()->user()->id,
+                'group_key' => $group, 'request_id' => $data['request_id'], 'parent_id' => $data['parent_id'] ?? null,
+                'media_id' => $media ? $media->id : null, 'text' => $data['text'] ?? null,
+                'captions' => $data['captions'] ?? null, 'satisfied' => $discuss->satisfied($data['text'] ?? null, $media, $scope['settings']),
+                'created_at' => now(), 'updated_at' => now()]);
+            $discuss->grade($assignment, $question, $scope);
+            return $id;
+        });
+        return response()->json(['id' => $id]);
+    }
+
+    public function update(Request $request, Assignment $assignment, Question $question, int $comment, DiscussIt $discuss)
+    {
+        $scope = $discuss->scope($assignment, $question, true);
+        $data = $request->validate(['text' => 'nullable|string|max:10000', 'captions' => 'nullable|string|max:20000']);
+        $this->mutate($assignment, $question, $comment, $scope, $discuss, false, $data);
+        return response()->json(['saved' => true]);
+    }
+
+    public function destroy(Assignment $assignment, Question $question, int $comment, DiscussIt $discuss)
+    {
+        $scope = $discuss->scope($assignment, $question, true);
+        $this->mutate($assignment, $question, $comment, $scope, $discuss, true, []);
+        return response()->json(['removed' => true]);
+    }
+
+    private function mutate($assignment, $question, $comment, $scope, $discuss, $delete, $data)
+    {
+        DB::transaction(function () use ($assignment, $question, $comment, $scope, $discuss, $delete, $data) {
+            DB::table('assignment_question')->where('assignment_id', $assignment->id)->where('question_id', $question->id)->lockForUpdate()->first();
+            $row = $discuss->comments($assignment, $question, $scope)->where('id', $comment)->whereNull('deleted_at')->first();
+            abort_unless($row, 404);
+            $moderation = $delete && $scope['owner'];
+            abort_unless($moderation || ((int) $row->user_id === (int) request()->user()->id && $scope['settings'][$delete ? 'allow_delete' : 'allow_edit']), 403);
+            abort_if(!$moderation && $discuss->graded($assignment, $question, (int) $row->user_id), 403, 'Graded responses cannot be changed.');
+            if ($delete) $values = ['deleted_at' => now()];
+            else {
+                abort_unless($row->media_id || trim($data['text'] ?? '') !== '', 422, 'A response cannot be empty.');
+                $media = $row->media_id ? DB::table('discuss_it_media')->where('id', $row->media_id)->first() : null;
+                $values = ['text' => $data['text'] ?? null, 'captions' => $data['captions'] ?? null,
+                    'satisfied' => $discuss->satisfied($data['text'] ?? null, $media, $scope['settings'])];
+            }
+            DB::table('discuss_it_comments')->where('id', $comment)->update(array_merge($values, ['updated_at' => now()]));
+            if (!$delete) $discuss->grade($assignment, $question, $scope);
+        });
+    }
+
+    public function upload(Request $request, Assignment $assignment, Question $question, DiscussIt $discuss)
+    {
+        $discuss->scope($assignment, $question, true);
+        $data = $request->validate(['kind' => 'required|in:audio,video', 'size' => 'required|integer|min:1|max:80000000']);
+        $userId = $request->user()->id;
+        abort_if(DB::table('discuss_it_media')->where('user_id', $userId)->whereIn('status', ['uploading', 'pending', 'processing'])->where('created_at', '>', now()->subHours(2))->count() >= 3, 429, 'Finish a pending upload before starting another.');
+        $id = (string) Str::uuid();
+        $key = "discuss-it/{$assignment->id}/{$question->id}/{$userId}/{$id}/input";
+        DB::table('discuss_it_media')->insert(['id' => $id, 'assignment_id' => $assignment->id, 'question_id' => $question->id, 'user_id' => $userId,
+            'object_key' => $key, 'kind' => $data['kind'], 'status' => 'uploading', 'created_at' => now(), 'updated_at' => now()]);
+        // MinIO is deliberately internal-only in this deployment. Stream through
+        // an authenticated, bounded same-origin PUT instead of exposing its host.
+        return response()->json(['id' => $id, 'url' => "/api/discuss-it/{$assignment->id}/{$question->id}/media/{$id}/content"]);
+    }
+
+    public function content(Request $request, Assignment $assignment, Question $question, string $media, DiscussIt $discuss)
+    {
+        $discuss->scope($assignment, $question, true);
+        $row = $this->ownedMedia($media, $assignment, $question);
+        abort_unless($row->status === 'uploading', 409, 'Upload is already being processed.');
+        abort_unless($row->created_at > now()->subHours(2)->toDateTimeString(), 410, 'Upload expired.');
+        abort_if((int) $request->header('Content-Length', 0) > 80000000, 413);
+        $source = $request->getContent(true);
+        $temporary = tmpfile();
+        try {
+            $size = stream_copy_to_stream($source, $temporary, 80000001);
+            abort_unless($size > 0 && $size <= 80000000, 413, 'Recording must be under 80 MB.');
+            rewind($temporary);
+            abort_unless(Storage::disk('s3')->put($row->object_key, $temporary, ['visibility' => 'private']), 503, 'Upload storage is unavailable. Please retry.');
+        } finally { fclose($source); fclose($temporary); }
+        return response()->json(['uploaded' => true]);
+    }
+
+    private function ownedMedia($id, $assignment, $question)
+    {
+        $media = DB::table('discuss_it_media')->where('id', $id)->where('assignment_id', $assignment->id)->where('question_id', $question->id)->where('user_id', request()->user()->id)->first();
+        abort_unless($media, 404);
+        return $media;
+    }
+
+    public function finalize(Assignment $assignment, Question $question, string $media, DiscussIt $discuss)
+    {
+        $discuss->scope($assignment, $question, true);
+        $row = $this->ownedMedia($media, $assignment, $question);
+        // Finalizing again is harmless. content() checks the expiry when an upload starts, so a
+        // slow upload it accepted can finish after it; only an upload never stored expires here.
+        if ($row->status === 'uploading') {
+            $stored = Storage::disk('s3')->exists($row->object_key);
+            abort_unless($stored || $row->created_at > now()->subHours(2)->toDateTimeString(), 410, 'Upload expired. Please upload again.');
+            abort_unless($stored, 422, 'Upload has not completed.');
+            abort_if(Storage::disk('s3')->size($row->object_key) > 80000000, 422, 'Video exceeds 80 MB.');
+            DB::table('discuss_it_media')->where('id', $media)->where('status', 'uploading')->update(['status' => 'pending', 'updated_at' => now()]);
+        }
+        return response()->json(['accepted' => true], 202);
+    }
+
+    public function media(Assignment $assignment, Question $question, string $media, DiscussIt $discuss)
+    {
+        $scope = $discuss->scope($assignment, $question);
+        $row = DB::table('discuss_it_media')->where('id', $media)->where('assignment_id', $assignment->id)->where('question_id', $question->id)->first();
+        abort_unless($row, 404);
+        $own = (int) $row->user_id === (int) request()->user()->id;
+        abort_unless($scope['settings']['enabled'] || $scope['owner'], 403);
+        abort_unless($own || $discuss->comments($assignment, $question, $scope)->where('media_id', $media)->whereNull('deleted_at')->exists(), 404);
+        return response()->json(['status' => $row->status, 'error' => $row->error, 'kind' => $row->kind, 'duration_ms' => $row->duration_ms,
+            'url' => $row->status === 'ready' ? URL::temporarySignedRoute('discuss-it.playback', now()->addMinutes(15), ['media' => $media, 'viewer' => request()->user()->id]) : null])->header('Cache-Control', 'private, no-store');
+    }
+
+    public function playback(Request $request, string $media, DiscussIt $discuss)
+    {
+        // This endpoint is guarded by Laravel's signed middleware. Recheck the
+        // signed viewer's current access so unenrollment/group changes take effect.
+        $viewer = \App\User::findOrFail((int) $request->query('viewer'));
+        auth()->setUser($viewer);
+        $request->setUserResolver(function () use ($viewer) { return $viewer; });
+        $row = DB::table('discuss_it_media')->where('id', $media)->where('status', 'ready')->first();
+        abort_unless($row, 404);
+        $assignment = Assignment::findOrFail($row->assignment_id);
+        $question = Question::findOrFail($row->question_id);
+        $scope = $discuss->scope($assignment, $question);
+        abort_unless($scope['settings']['enabled'] || $scope['owner'], 403);
+        abort_unless((int) $row->user_id === (int) $viewer->id || $discuss->comments($assignment, $question, $scope)->where('media_id', $media)->whereNull('deleted_at')->exists(), 404);
+        $disk = Storage::disk('s3');
+        $size = $disk->size($row->output_key);
+        $start = 0; $end = $size - 1; $status = 200;
+        if ($request->hasHeader('Range')) {
+            $range = $request->header('Range');
+            if (!preg_match('/^bytes=(\d*)-(\d*)$/D', $range, $match) || ($match[1] === '' && $match[2] === '')) return response('', 416)->header('Content-Range', 'bytes */'.$size);
+            if ($match[1] === '') $start = max(0, $size - (int) $match[2]);
+            else { $start = (int) $match[1]; if ($match[2] !== '') $end = min($end, (int) $match[2]); }
+            if ($start > $end || $start >= $size) return response('', 416)->header('Content-Range', 'bytes */'.$size);
+            $status = 206;
+        }
+        $adapter = $disk->getDriver()->getAdapter();
+        $object = $adapter->getClient()->getObject(['Bucket' => $adapter->getBucket(), 'Key' => $row->output_key, 'Range' => "bytes={$start}-{$end}"]);
+        $headers = ['Content-Type' => $row->kind === 'video' ? 'video/mp4' : 'audio/mp4', 'Content-Length' => (string) ($end - $start + 1),
+            'Accept-Ranges' => 'bytes', 'Cache-Control' => 'private, no-store', 'X-Content-Type-Options' => 'nosniff'];
+        if ($status === 206) $headers['Content-Range'] = "bytes {$start}-{$end}/{$size}";
+        return response()->stream(function () use ($object) {
+            $stream = $object['Body'];
+            try { while (!$stream->eof()) { echo $stream->read(65536); if (connection_aborted()) break; } }
+            finally { $stream->close(); }
+        }, $status, $headers);
+    }
+}
