@@ -0,0 +1,32 @@
+<?php
+
+namespace App\Console\Commands\LibreTexts;
+
+use App\Services\DiscussItMediaProcessor;
+use Illuminate\Console\Command;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Storage;
+
+class ProcessDiscussItMedia extends Command
+{
+    protected $signature = 'discuss-it:process-media {--once : Process at most one item}';
+    protected $description = 'Process bounded Discuss-It media jobs and remove expired unreferenced uploads.';
+
+    public function handle(DiscussItMediaProcessor $processor)
+    {
+        // Only this feature's rows/objects are eligible; never traverse shared storage.
+        DB::table('discuss_it_media')->where('status', 'processing')->where('updated_at', '<', now()->subMinutes(10))
+            ->update(['status' => 'failed', 'error' => 'Processing was interrupted. Please upload again.', 'updated_at' => now()]);
+        foreach (DB::table('discuss_it_media')->where('created_at', '<', now()->subDays(7))->whereNotExists(function ($query) {
+            $query->select(DB::raw(1))->from('discuss_it_comments')->whereColumn('media_id', 'discuss_it_media.id');
+        })->limit(20)->get() as $expired) {
+            Storage::disk('s3')->delete(array_filter([$expired->object_key, $expired->output_key]));
+            DB::table('discuss_it_media')->where('id', $expired->id)->delete();
+        }
+        $jobs = DB::table('discuss_it_media')->where('status', 'pending')->orderBy('created_at')->limit($this->option('once') ? 1 : 3)->get();
+        foreach ($jobs as $job) {
+            if (DB::table('discuss_it_media')->where('id', $job->id)->where('status', 'pending')->update(['status' => 'processing', 'updated_at' => now()])) $processor->process($job);
+        }
+        return 0;
+    }
+}
