+<?php
+
+namespace App\Http\Middleware;
+
+use Closure;
+use Illuminate\Foundation\Http\Middleware\ValidatePostSize;
+use Illuminate\Http\Exceptions\PostTooLargeException;
+
+class ValidateDiscussItPostSize extends ValidatePostSize
+{
+    public function handle($request, Closure $next)
+    {
+        // Only this authenticated streaming PUT has the larger video limit.
+        // Preserve the existing PHP-derived limit for all other ADAPT requests.
+        if ($request->isMethod('PUT') && $request->is('api/discuss-it/*/*/media/*/content')) {
+            if ((int) $request->server('CONTENT_LENGTH', 0) > 80000000) throw new PostTooLargeException();
+            return $next($request);
+        }
+        return parent::handle($request, $next);
+    }
+}
